# GEMINI_API_KEY: Optional server-side key for Doctor Nomen AI voice service (runs offline without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_BASE_PATH: Optional base path (set to "/your-repo-name/" for GitHub Pages project sites)
VITE_BASE_PATH="/"

# Google Sheets + Apps Script Sync (optional — leave empty to run offline-only without crashing)
VITE_APPS_SCRIPT_URL=""
VITE_APPS_SCRIPT_SECRET=""
