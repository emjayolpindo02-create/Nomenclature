# GEMINI_API_KEY: Optional for Doctor Nomen online AI voice service (runs offline without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL (/exec)
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec"

# VITE_APPS_SCRIPT_SECRET: Shared secret matching APP_SECRET on line 14 of apps-script/Code.gs
VITE_APPS_SCRIPT_SECRET="PASTE_YOUR_SECRET_HERE"

# VITE_BASE_PATH: Optional base path (set to "/your-repo-name/" for GitHub Pages project sites)
VITE_BASE_PATH="/"
