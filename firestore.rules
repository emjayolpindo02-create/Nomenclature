rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isValidStudent(data, studentId) {
      return data.keys().hasAll(['uid', 'displayName', 'section', 'approved', 'blocked', 'progress', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'section', 'email', 'isAnonymous', 'approved', 'blocked', 'progress', 'dailyRetries', 'createdAt', 'updatedAt'])
        && !('unlockedLevels' in data)
        && data.uid is string && data.uid == studentId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.section is string && data.section.size() >= 1 && data.section.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('isAnonymous' in data) || data.isAnonymous is bool)
        && data.approved is bool
        && data.blocked is bool
        && data.progress is map && data.progress.size() <= 20
        && (!('dailyRetries' in data) || (data.dailyRetries is map && data.dailyRetries.size() <= 5))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopicsSettings(data) {
      return data.keys().hasAll(['maxRetriesPerDay', 'topics', 'updatedAt'])
        && data.keys().hasOnly(['maxRetriesPerDay', 'topics', 'updatedAt', 'updatedBy'])
        && data.maxRetriesPerDay is number && data.maxRetriesPerDay >= 0 && data.maxRetriesPerDay <= 50
        && data.topics is map && data.topics.size() <= 20
        && data.updatedAt is timestamp
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Teacher allowlist: UIDs added via Firebase Console. Users can only check their own UID doc.
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && isValidId(teacherId) && request.auth.uid == teacherId;
      allow list, write: if false;
    }

    // Student profiles and progress
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isOwner(studentId) || isTeacher());
      allow list: if isTeacher();
      allow create: if isSignedIn()
        && isValidId(studentId)
        && isOwner(studentId)
        && isValidStudent(incoming(), studentId)
        && incoming().approved == false
        && incoming().blocked == false
        && incoming().progress.size() == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(studentId)
        && isValidStudent(incoming(), studentId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isTeacher()
          || (
            isOwner(studentId)
            && incoming().approved == existing().approved
            && incoming().blocked == existing().blocked
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'section', 'email', 'isAnonymous', 'updatedAt'])
              || (
                existing().approved == true
                && existing().blocked == false
                && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'section', 'progress', 'dailyRetries', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isTeacher() && isValidId(studentId);
    }

    // Teacher-controlled topic rules and daily retry settings
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && settingId == 'topics';
      allow list: if false;
      allow create, update: if isTeacher()
        && isValidId(settingId)
        && settingId == 'topics'
        && isValidTopicsSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Connection check doc
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }
  }
}
