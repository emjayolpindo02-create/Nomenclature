{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account profile isolated per authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Private user email address.",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "LessonProgress": {
      "title": "LessonProgress",
      "description": "Private per-lesson score, pass status, and date used for next-day lesson unlocking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the owning user.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "libraryId": {
          "type": "string",
          "description": "Identifier of the lesson or practice set.",
          "maxLength": 64,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "passed": {
          "type": "boolean",
          "description": "Whether the required passing score was acquired."
        },
        "bestScore": {
          "type": "number",
          "description": "Highest percentage score achieved (0-100)."
        },
        "attempts": {
          "type": "number",
          "description": "Total completed attempts."
        },
        "passedDate": {
          "type": "string",
          "description": "Local YYYY-MM-DD date when the passing score was first acquired, or empty string if not yet passed.",
          "maxLength": 10
        },
        "passedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp when the passing score was first acquired."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest attempt."
        }
      },
      "required": ["userId", "libraryId", "passed", "bestScore", "attempts", "passedDate", "completedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Private UI customization preferences for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the owning user.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "sepia", "high-contrast", "system"]
        },
        "accentColor": {
          "type": "string",
          "enum": ["indigo", "blue", "emerald", "amber", "rose", "teal", "violet"]
        },
        "fontFamily": {
          "type": "string",
          "enum": ["system", "serif", "mono", "dyslexic"]
        },
        "fontSize": {
          "type": "string",
          "enum": ["sm", "md", "lg", "xl"]
        },
        "density": {
          "type": "string",
          "enum": ["compact", "comfortable", "spacious"]
        },
        "cornerRoundness": {
          "type": "string",
          "enum": ["sharp", "rounded", "soft"]
        },
        "animations": {
          "type": "boolean"
        },
        "realSubscripts": {
          "type": "boolean"
        },
        "periodicColorBy": {
          "type": "string",
          "enum": ["category", "block", "variable-metal"]
        },
        "hintsEnabled": {
          "type": "boolean"
        },
        "passingScore": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "theme", "accentColor", "fontFamily", "fontSize", "density", "cornerRoundness", "animations", "realSubscripts", "periodicColorBy", "hintsEnabled", "passingScore", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account document; readable and writable only by the matching authenticated user."
    },
    "/users/{userId}/progress/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonProgress" },
      "description": "Private per-lesson progress records for the owning user."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "Private UI settings for the owning user."
    }
  }
}
